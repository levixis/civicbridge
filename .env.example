# Run python scripts/init_env.py to create random local secrets.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=<generate>
REVENUE_DJANGO_SECRET_KEY=<generate>
DOCUMENT_ENCRYPTION_KEY=<Fernet-key>
GRANT_SIGNING_KEY=<generate>
REVENUE_API_TOKEN=<generate>
REVENUE_API_URL=http://127.0.0.1:8001
ALLOW_LOCAL_HTTP=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
REVENUE_ALLOWED_HOSTS=localhost,127.0.0.1,revenue
# Optional PostgreSQL credentials. The local launcher uses SQLite.
POSTGRES_USER=civicbridge
POSTGRES_PASSWORD=<generate>
REVENUE_POSTGRES_USER=revenue
REVENUE_POSTGRES_PASSWORD=<generate>
# SMTP configuration for production account recovery.
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# DEFAULT_FROM_EMAIL=CivicBridge <noreply@example.org>

# Separate sample-only sandbox workspace. No private API Setu credentials required.
SANDBOX_ENABLED=1

# Local platform extensions; init_env.py creates random secrets automatically.
MUNICIPAL_DJANGO_SECRET_KEY=GENERATE_WITH_INIT_ENV
IDENTITY_DJANGO_SECRET_KEY=GENERATE_WITH_INIT_ENV
MUNICIPAL_API_TOKEN=GENERATE_WITH_INIT_ENV
AUDIT_CHAIN_KEY=GENERATE_WITH_INIT_ENV
MUNICIPAL_API_URL=http://127.0.0.1:8002
SSO_ISSUER=http://127.0.0.1:8003
SSO_PORTAL_SECRET=GENERATE_WITH_INIT_ENV
SSO_REVENUE_SECRET=GENERATE_WITH_INIT_ENV
SSO_MUNICIPALITY_SECRET=GENERATE_WITH_INIT_ENV
